# CrowdStrike Falcon API client credentials.
# Create an API client at https://falcon.crowdstrike.com/api-clients-and-keys
# with scopes: IOC Management (read/write), Indicators (read).
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
# Falcon cloud base URL. Use the region your tenant lives in:
# US-1: https://api.crowdstrike.com
# US-2: https://api.us-2.crowdstrike.com
# EU-1: https://api.eu-1.crowdstrike.com
CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com

# Optional: ThreatFox requires no key for read access, but abuse.ch asks
# feed consumers to identify themselves. Set a contact if you have one.
ABUSE_CH_CONTACT=
